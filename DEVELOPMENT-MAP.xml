<development-map project="volum-admin" version="1" baseline="e16c87f213a5ba5e45964e9b67c792105ec74d26">
  <purpose>Source-backed dictionary of pages, sections, shared surfaces, and implementation gaps. Not a task queue or backend specification.</purpose>
  <vocabulary>
    <term name="page">A navigable leaf route. URL patterns exclude pathless route groups.</term>
    <term name="section">A named page region, form, table, tab group, or overlay; source is the edit owner.</term>
    <term name="layout">A shared wrapper inherited by pages; layout names do not imply authorization.</term>
    <term name="demo">Fixture data or simulated submission; no operational persistence promised.</term>
    <term name="local">Browser-local presentation, navigation, or preferences.</term>
    <term name="provider">Conditional Clerk behavior requiring configuration; does not imply backend implementation.</term>
    <term name="placeholder">Rendered placeholder without the intended feature.</term>
    <term name="disabled">Visible but unavailable control.</term>
    <term name="missing">Linked destination or behavior without implementation.</term>
  </vocabulary>
